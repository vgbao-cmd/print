{
  "name": "live-avatar-printer", "version": "1.5.0", "private": true,
  "description": "An animated avatar printer for TikTok LIVE", "author": "Live Avatar Printer", "license": "AGPL-3.0-only",
  "type": "module", "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs", "typecheck": "tsc --noEmit", "test": "vitest run",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "start": "electron .", "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win portable", "smoke": "electron . --smoke-test",
    "benchmark": "node scripts/benchmark.mjs", "check:visual":"electron . --visual-test", "check:premium":"electron . --premium-test", "check:shows":"electron . --show-test", "check:guide":"electron . --guide-test"
  },
  "dependencies": {"react":"^19.0.0","react-dom":"^19.0.0","tiktok-live-connector":"2.5.0"},
  "devDependencies": {"@types/node":"^22.0.0","@types/react":"^19.0.0","@types/react-dom":"^19.0.0","@vitejs/plugin-react":"^4.3.4","electron":"^39.0.0","electron-builder":"^26.0.0","esbuild":"^0.25.0","typescript":"^5.7.0","vite":"^6.1.0","vitest":"^3.0.0"},
  "build": {
    "appId":"app.liveavatarprinter.desktop", "productName":"Live Avatar Printer",
    "directories":{"output":"release"}, "files":["dist/**/*","dist-electron/**/*","resources/demo-portrait.jpg","resources/gifts/*.webp","src/assets/*-OFL.txt","package.json","README.md","VALIDATION.md","LIVE-STUDIO-SETUP.md","LICENSE","THIRD_PARTY_NOTICES.md"],
    "asar":true,"npmRebuild":false,
    "win":{"target":"portable","signExecutable":false},
    "portable":{"artifactName":"Live-Avatar-Printer-${version}-Windows.exe"}
  }
}
